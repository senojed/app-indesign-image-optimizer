// Generated by scripts/build-english.cjs; edit lib/ and locales/en.json.
/* Serialized into a BridgeTalk message; no dependency on InDesign globals. */
function IIOPhotoshop(job, C) {
    function fail(ok,msg){C.assert(ok,msg);}
    function actions(){
        var sets=[], i,j,r,d,a,s;
        for(i=1;i<=10000;i++){
            r=new ActionReference();r.putIndex(charIDToTypeID('ASet'),i);
            try{d=executeActionGet(r);}catch(end){break;}
            s={name:d.getString(charIDToTypeID('Nm  ')),actions:[]};
            for(j=1;j<=d.getInteger(charIDToTypeID('NmbC'));j++){
                r=new ActionReference();r.putIndex(charIDToTypeID('Actn'),j);r.putIndex(charIDToTypeID('ASet'),i);
                a=executeActionGet(r);s.actions.push(a.getString(charIDToTypeID('Nm  ')));
            }
            sets.push(s);
        }
        return {ok:true,sets:sets,version:app.version};
    }
    function preservePolicies(){
        var r=new ActionReference(), keys=['policyRGB','policyCMYK','policyGray'],i,d,k;
        r.putProperty(charIDToTypeID('Prpr'),stringIDToTypeID('colorSettings'));
        r.putEnumerated(charIDToTypeID('capp'),charIDToTypeID('Ordn'),charIDToTypeID('Trgt'));
        d=executeActionGet(r).getObjectValue(stringIDToTypeID('colorSettings'));
        for(i=0;i<keys.length;i++){
            k=stringIDToTypeID(keys[i]);
            fail(d.hasKey(k) && typeIDToStringID(d.getEnumerationValue(k))==='preserve',
                'Photoshop Color Settings: '+keys[i]+" must be set to Preserve Embedded Profiles.");
        }
    }
    function alive(doc){if(!doc){return false;}for(var i=0;i<app.documents.length;i++){if(app.documents[i]===doc){return true;}}return false;}
    function close(doc){if(alive(doc)){doc.close(SaveOptions.DONOTSAVECHANGES);}}
    function meta(doc){
        return {w:doc.width.as('px'),h:doc.height.as('px'),resolution:doc.resolution,
            mode:String(doc.mode),bits:String(doc.bitsPerChannel),profileType:String(doc.colorProfileType),
            profile:doc.colorProfileType===ColorProfile.NONE?'':doc.colorProfileName};
    }
    function layers(collection){var n=0;for(var i=0;i<collection.length;i++){n++;if(collection[i].typename==='LayerSet'){n+=layers(collection[i].layers);}}return n;}
    function checkStop(){fail(!(new File(job.cancel)).exists,"Batch cancelled.");}
    function putResult(path, data){var f=new File(path);f.encoding='UTF-8';fail(f.open('w'),"Cannot write worker status.");try{fail(f.write(C.json(data)),"Cannot write worker status.");}finally{f.close();}}
    if(job.op==='actions'){try{return C.json(actions());}catch(ae){return C.json({ok:false,error:String(ae),fatal:false});}}
    var opened=null, working=null, verified=null, originalActive=null, oldDialogs=app.displayDialogs,
        result={ok:false,error:"Worker did not complete.",fatal:false}, before, after, outputMeta, dims, count, workID;
    if($.global.__iioBusy){return C.json({ok:false,error:"Photoshop worker is already running.",fatal:true});}
    $.global.__iioBusy=true;
    try{
        if(app.documents.length){originalActive=app.activeDocument;}
        if(job.action){fail(app.documents.length===0,"Close other Photoshop documents before running an action.");}
        preservePolicies();checkStop();
        fail(!(new File(job.output)).exists,"Temporary output already exists.");
        app.displayDialogs=DialogModes.NO;
        opened=app.open(new File(job.input));
        working=opened.duplicate('IIO working '+job.id,false);close(opened);opened=null;
        app.activeDocument=working;workID=working.id;before=meta(working);
        fail(before.w>0 && before.h>0,"Invalid source dimensions.");
        dims=C.dimensions(before.w,before.h,job.factor);
        if(dims[0]!==before.w || dims[1]!==before.h){
            working.resizeImage(UnitValue(dims[0],'px'),UnitValue(dims[1],'px'),before.resolution,ResampleMethod.BICUBIC);
        }
        after=meta(working);
        fail(after.mode===before.mode && after.bits===before.bits && after.profile===before.profile && after.profileType===before.profileType,
            "Resampling changed color mode, bit depth or ICC profile.");
        checkStop();
        if(job.action){
            app.doAction(job.action,job.set);
            fail(alive(working) && app.documents.length===1 && app.activeDocument.id===workID,
                "The action closed, replaced or added a document.");
            outputMeta=meta(working);
            fail(outputMeta.w===after.w && outputMeta.h===after.h && outputMeta.resolution===after.resolution,
                "The action changed dimensions or resolution. The item will not be relinked.");
        }
        checkStop();outputMeta=meta(working);count=layers(working.layers);
        var options=new PhotoshopSaveOptions();options.layers=true;options.alphaChannels=true;
        /* Embedding on an untagged document would assign the working profile in Photoshop. */
        options.embedColorProfile=working.colorProfileType!==ColorProfile.NONE;options.annotations=true;options.spotColors=true;
        working.saveAs(new File(job.output),options,true,Extension.LOWERCASE);
        close(working);working=null;checkStop();
        fail((new File(job.output)).exists && (new File(job.output)).length>0,"PSD was not saved.");
        verified=app.open(new File(job.output));
        var reopened=meta(verified);
        fail(reopened.w===outputMeta.w && reopened.h===outputMeta.h && Math.abs(reopened.resolution-outputMeta.resolution)<=0.001 &&
            reopened.mode===outputMeta.mode && reopened.bits===outputMeta.bits && reopened.profile===outputMeta.profile && reopened.profileType===outputMeta.profileType,
            "Reopened PSD has different dimensions, mode or profile: "+C.json(outputMeta)+' -> '+C.json(reopened));
        fail(layers(verified.layers)===count,"PSD did not preserve the layer structure.");
        close(verified);verified=null;checkStop();
        result={ok:true,before:before,after:outputMeta,layers:count,version:app.version};
    }catch(e){result={ok:false,error:String(e),fatal:!!job.action};}
    finally{
        try{close(verified);close(working);close(opened);}catch(ce){result={ok:false,error:"Photoshop cleanup failed: "+String(ce),fatal:true};}
        try{app.displayDialogs=oldDialogs;if(alive(originalActive)){app.activeDocument=originalActive;}}catch(pe){result={ok:false,error:"Restoring Photoshop preferences failed: "+String(pe),fatal:true};}
        $.global.__iioBusy=false;
        try{putResult(job.done,result);}catch(de){result={ok:false,error:String(de),fatal:true};}
    }
    return C.json(result);
}
